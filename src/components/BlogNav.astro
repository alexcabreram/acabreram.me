---
import ThemeToggle from "./ThemeToggle.astro";
import BrandLockup from "./BrandLockup.astro";

interface Props {
  lang?: "en" | "es";
  /** URL of this page in the other language. Defaults to the other blog index. */
  altHref?: string;
  /** Marks "Escritos" as the current section. */
  current?: "writing" | null;
}

const { lang = "en", altHref, current = "writing" } = Astro.props;
const es = lang === "es";
const homeHref = es ? "/es/" : "/";
const blogHref = es ? "/es/blog/" : "/blog/";
const aboutHref = es ? "/es/#about" : "/#about";
const langToggleHref = altHref ?? (es ? "/blog/" : "/es/blog/");
---

<nav class="section-shell flex items-center justify-between gap-4 py-5" aria-label={es ? "Navegación del sitio" : "Site navigation"}>
  <a href={homeHref} class="inline-flex items-center" aria-label={es ? "acm. — inicio" : "acm. — home"}>
    <BrandLockup size={24} textSize={18} />
  </a>

  <div class="flex items-center gap-4 font-mono text-xs">
    <a
      href={blogHref}
      class:list={["transition-colors hover:text-seiryu", current === "writing" ? "text-text underline decoration-seiryu decoration-1 underline-offset-[6px]" : "text-muted"]}
      aria-current={current === "writing" ? "page" : undefined}
    >
      {es ? "Escritos" : "Writing"}
    </a>
    <a href={aboutHref} class="hidden text-muted transition-colors hover:text-seiryu sm:inline">{es ? "Sobre mí" : "About"}</a>
    <a
      href="https://www.linkedin.com/in/alexcabreram/"
      target="_blank"
      rel="noreferrer"
      class="text-muted transition-colors hover:text-seiryu"
      aria-label="LinkedIn"
    >
      in
    </a>
    <a
      href={langToggleHref}
      hreflang={es ? "en" : "es"}
      class="control-pill inline-flex h-8 min-w-8 items-center justify-center px-2 text-[11px] uppercase tracking-wider text-text"
      style="border-radius: 2px"
      aria-label={es ? "Read in English" : "Leer en español"}
    >
      {es ? "EN" : "ES"}
    </a>
    <ThemeToggle />
  </div>
</nav>
