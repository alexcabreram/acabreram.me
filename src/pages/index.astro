---
import Layout from "../layouts/Layout.astro";
import Home from "../components/home/Home.astro";
import { homeCopy } from "../i18n/home";
---

<Layout lang="en" title={homeCopy.en.meta.title} description={homeCopy.en.meta.description} turn="night">
  <Fragment slot="head">
    <script is:inline>
      // Send Spanish browsers to /es/ unless the visitor already picked a language.
      try {
        // Migrate the old "lang" cookie (manual choice) to the new preference, then clear it.
        if (document.cookie.includes("lang=")) {
          localStorage.setItem("acm-lang", "en");
          document.cookie = "lang=; Max-Age=0; path=/";
        }
        if (!localStorage.getItem("acm-lang") && (navigator.language || "en").toLowerCase().startsWith("es")) {
          location.replace("/es/");
        }
      } catch {
        // Storage blocked: stay on the English page.
      }
    </script>
  </Fragment>
  <Home lang="en" />
</Layout>
