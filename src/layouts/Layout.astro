---
import "../styles/global.css";
import { translations, type Locale } from "../i18n/translations";

interface Props {
  lang?: Locale;
  title?: string;
  description?: string;
  ogImage?: string;
  /** Language alternates for hreflang. Defaults to the /es/ mirror of the current path; pass false when the page has no counterpart. */
  alternates?: false | { en: string; es: string };
  /** Blog turn: the page opens in day (light) or night (dark) mode unless the reader chose a theme. */
  turn?: "day" | "night";
  /** Open Graph type; blog posts are articles. */
  ogType?: "website" | "article";
  /** Article metadata for og:type=article. */
  article?: { published: Date; modified?: Date; tags?: string[] };
  /** Extra schema.org nodes appended to the page's JSON-LD graph. */
  schema?: Record<string, unknown>[];
}

const { lang = "en", title, description, ogImage, alternates, turn, ogType = "website", article, schema = [] } = Astro.props;
const meta = translations[lang].meta;
const resolvedTitle = title ?? meta.title;
const resolvedDescription = description ?? meta.description;

const siteUrl = Astro.site ?? new URL("https://acabreram.com");
const canonical = new URL(Astro.url.pathname, siteUrl).toString();

const pathname = Astro.url.pathname;
const isEs = pathname === "/es" || pathname.startsWith("/es/");
const defaultAlternates = isEs
  ? { en: pathname.replace(/^\/es/, "") || "/", es: pathname }
  : { en: pathname, es: pathname === "/" ? "/es/" : `/es${pathname}` };
const resolvedAlternates = alternates === false ? null : (alternates ?? defaultAlternates);
const resolvedOgImage = ogImage
  ? new URL(ogImage, siteUrl).toString()
  : new URL("/og-image.png", siteUrl).toString();
---

<!doctype html>
<html lang={lang} data-theme={turn === "day" ? "light" : "dark"} data-turn={turn} class="bg-background text-text">
  <head>
    <script is:inline>
      (() => {
        const storageKey = "acm-theme";
        const root = document.documentElement;
        const turn = root.dataset.turn;
        const prefersLight = () =>
          typeof window.matchMedia === "function" && window.matchMedia("(prefers-color-scheme: light)").matches;
        let theme = turn === "day" ? "light" : turn === "night" ? "dark" : prefersLight() ? "light" : "dark";

        try {
          const stored = localStorage.getItem(storageKey);
          if (stored === "light" || stored === "dark") {
            theme = stored;
          }
        } catch {
          // Storage can be blocked; keep the turn or system theme.
        }

        root.setAttribute("data-theme", theme);
        root.style.colorScheme = theme;
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={resolvedDescription} />
    <meta name="theme-color" content="#04080F" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/seiryu-favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/dm-serif-display-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {resolvedAlternates && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(resolvedAlternates.en, siteUrl).toString()} />
        <link rel="alternate" hreflang="es" href={new URL(resolvedAlternates.es, siteUrl).toString()} />
        <link rel="alternate" hreflang="x-default" href={new URL(resolvedAlternates.en, siteUrl).toString()} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title="Alex Cabrera — Blog" href="/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    {article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
        <meta property="article:author" content="Alex Cabrera" />
        {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="acabreram.com" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <slot name="head" />
    <title>{resolvedTitle}</title>


    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": new URL("/#website", siteUrl).toString(),
          "name": "acabreram.com",
          "url": siteUrl.toString(),
          "description": resolvedDescription,
          "inLanguage": lang,
          "publisher": { "@id": new URL("/#person", siteUrl).toString() }
        },
        {
          "@type": "Person",
          "@id": new URL("/#person", siteUrl).toString(),
          "name": "Alex Cabrera",
          "alternateName": "Alejandro Cabrera Martínez",
          "url": siteUrl.toString(),
          "jobTitle": "Copilot Solution Engineer",
          "worksFor": { "@type": "Organization", "name": "Microsoft" },
          "sameAs": [
            "https://www.linkedin.com/in/alexcabreram",
            "https://github.com/alexcabreram",
            "https://sessionize.com/alejandro-cabrera-martinez"
          ],
          "knowsAbout": ["Microsoft 365 Copilot", "Copilot Studio", "AI agents", "Enterprise AI governance", "Power Platform", "Azure", "Self-hosted AI"]
        },
        ...schema
      ]
    })} />
  </head>
  <body class="min-h-screen bg-background text-text antialiased">
    <!-- Skip to content link — accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:border focus:border-[var(--color-seiryu)] focus:bg-background focus:px-4 focus:py-2 focus:text-sm focus:text-[var(--color-seiryu)] focus:outline-none"
    >
      Skip to content
    </a>
    <div class="relative isolate overflow-x-clip">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[32rem]"
        style="background: radial-gradient(circle at top, var(--hero-radial), transparent 45%)"
      ></div>
      <slot />
    </div>
  </body>
</html>
